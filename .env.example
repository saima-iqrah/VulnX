# Copy values into user-secrets (dev) or real environment variables (prod). NEVER commit real values.
# ASP.NET maps "__" to ":" in config keys.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=vulnx_db;Username=vulnx_app;Password=CHANGE_ME

# JWT signing key: at least 32 random characters. Generate e.g. with: openssl rand -base64 48
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=VulnX
Jwt__Audience=VulnX.Web

Cors__AllowedOrigins__0=http://localhost:5173
Frontend__BaseUrl=http://localhost:5173
Auth__RequireConfirmedEmail=false

# Optional first-admin seed (admin is only created when Seed__Enabled=true)
Seed__Enabled=false
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=CHANGE_ME_Strong#Pass1

# ---- Docker Compose (docker compose up -d --build) ----
POSTGRES_PASSWORD=CHANGE_ME
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
PUBLIC_URL=http://localhost:8080
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_Strong#Pass1
